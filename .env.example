# GEMINI_API_KEY: Required for server-side Gemini API calls. Never prefix with VITE_.
# AI Studio can provide this as a server-side secret.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted app URL, if your environment uses it.
APP_URL="MY_APP_URL"

# Spotify Client ID is public; it is safe for the browser. Never add a Spotify client secret.
# Register the exact redirect URI (your app origin + "/") in Spotify for Developers.
VITE_SPOTIFY_CLIENT_ID="YOUR_SPOTIFY_CLIENT_ID"
# Optional. If omitted, the app uses the current host's origin + "/".
# VITE_SPOTIFY_REDIRECT_URI="https://your-production-host/"
